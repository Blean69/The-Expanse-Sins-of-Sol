  "art_merge_policy": "Copy private art aliases and UI files; any already-present donor material/texture must match bytes and be skipped, never overwritten.",
  "localization": {
    "expanse24_behemoth.name": "OPA Behemoth",
    "expanse24_behemoth.description": "A costly shieldless logistics titan rebuilt from a generation ship. Eight defensive PDCs, limited surplus torpedoes, targeted hospital engineering and a mobile component shop. Thin protection, slow movement and no railguns. Shares the ordinary titan limit.",
    "expanse24_behemoth_pdc.name": "Behemoth point defense",
    "expanse24_behemoth_pdc.description": "One defensive gun: 85 base damage per second, Earth tracking profile, hull-safe restricted arcs. No railgun.",
    "expanse24_behemoth_loot_name": "Behemoth wreckage",
    "expanse24_behemoth_magazine.name": "Behemoth surplus torpedo magazine",
    "expanse24_behemoth_magazine.description": "Eight existing UNN-profile light torpedoes: two per ten seconds, 120-second reload after the last pair. Base damage 750 each, speed 2125, 30-second fuel; native missile research applies. No planetary or global launch capability.",
    "expanse24_behemoth_hospital.name": "Hospital Engineering Teams",
    "expanse24_behemoth_hospital.description": "Repairs one other nearby owned ship for 40 hull per second over 20 seconds, capped at 800. Range 6000; 100 antimatter; 60-second cooldown. Autocast below 80% hull. Shares Scirocco/Fleet Train repair exclusion. While operating, Behemoth loses 25% speed and its PDC reload time rises 25% for 20 seconds. Armor and shields are not restored.",
    "expanse24_behemoth_hospital_grid_load.name": "Hospital grid priority",
    "expanse24_behemoth_hospital_grid_load.description": "For 20 seconds, propulsion speed is reduced 25% and PDC cooldown duration increased 25%. The fixed torpedo-magazine schedule is unchanged. No full weapon shutdown."
  },
